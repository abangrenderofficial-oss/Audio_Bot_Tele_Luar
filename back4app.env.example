# Required
BOT_TOKEN=
ADMIN_ID=

# Optional: official Telegram API is used automatically when omitted
CUSTOM_API_URL=https://api.telegram.org

# Back4app web-service health port
PORT=8080

# Low-resource defaults for the free container
BOT_POLLING_TASKS_CONCURRENCY_LIMIT=4
BOT_SESSION_CONNECTION_LIMIT=20
DOWNLOAD_QUEUE_MIN_WORKERS=1
DOWNLOAD_QUEUE_MAX_WORKERS=1
DOWNLOAD_QUEUE_MAX_SIZE=25
DOWNLOAD_QUEUE_PER_USER_RATE_LIMIT=2
DOWNLOAD_QUEUE_PER_USER_WINDOW_SECONDS=10
DOWNLOAD_QUEUE_PER_USER_MAX_PENDING=1
DOWNLOAD_QUEUE_PER_USER_PENDING_TIMEOUT_SECONDS=20
DOWNLOAD_MAX_WORKERS_CAP=1
BATCH_LINKS_MIN_CONCURRENCY=1
BATCH_LINKS_MAX_CONCURRENCY=1
BATCH_LINKS_MAX_ITEMS=3

# Optional platform helpers
COBALT_API_URL=
COBALT_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=MY
YTDLP_YOUTUBE_COOKIES_FILE=
YTDLP_YOUTUBE_JS_RUNTIMES=deno,node
YTDLP_YOUTUBE_REMOTE_COMPONENTS=ejs:github
YTDLP_YOUTUBE_PLAYER_CLIENT=web,android
YTDLP_YOUTUBE_PO_TOKEN=

# Optional analytics extras
MEASUREMENT_ID=
API_SECRET=
CHANNEL_ID=

# DATABASE_URL is intentionally omitted. Without it, the bot uses transient
# in-memory state and does not require PostgreSQL/Supabase/Neon.
