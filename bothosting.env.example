# MusiX BotHosting ENV template (copy values into BotHosting environment settings).
# This is a TEMPLATE ONLY: never commit real credentials.
# Required; use the EXISTING music bot token and production PostgreSQL DB:
BOT_TOKEN=
ADMIN_ID=
DATABASE_URL=

# Telegram API; public official API is a suitable default for normal bot uploads.
CUSTOM_API_URL=https://api.telegram.org

# Optional music caches and fallback services (only copy values you already use):
MUSIC_CACHE_API_URL=
MUSIC_CACHE_API_KEY=
COBALT_API_URL=
COBALT_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
CHANNEL_ID=

# Optional: configured by startup.py automatically for the BotHosting shared plan:
# BOT_POLLING_TASKS_CONCURRENCY_LIMIT=24
# BOT_SESSION_CONNECTION_LIMIT=60
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=3
# DOWNLOAD_QUEUE_MIN_WORKERS=1
# DOWNLOAD_QUEUE_MAX_WORKERS=3
# DOWNLOAD_MAX_WORKERS_CAP=3
# BATCH_LINKS_MAX_CONCURRENCY=2
# YTDLP_YOUTUBE_JS_RUNTIMES=deno

# Explicitly DO NOT set TELEGRAM_WEBHOOK_BASE_URL / RENDER_EXTERNAL_URL.
# Avoid pointing any URL at localhost or Render-private addresses.
# Do not enable self-tests which deliver Telegram audio on startup.
